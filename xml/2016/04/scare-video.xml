  <item>
    <title>Scare Video</title>
    <link>http://flyingsummers.com/2016/04/26/scare-video/</link>
    <pubDate>Tue, 26 Apr 2016 21:30:16 +0000</pubDate>
    <dc:creator>colinsummers</dc:creator>
